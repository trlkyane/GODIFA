# GODIFA Environment Configuration - PRODUCTION
# File này dùng cho VPS - Khi deploy, rename thành .env

# ==================== ENVIRONMENT ====================
APP_ENV=production

# ==================== DATABASE ====================
DB_HOST=localhost
DB_NAME=godifa_production
DB_USER=godifa_user
DB_PASS=Godifa@2025

# ==================== APPLICATION ====================
BASE_URL=https://godifaproject.id.vn/

# ==================== WEBSOCKET ====================
SOCKET_SERVER_URL=https://godifaproject.id.vn/ws

# ==================== SEPAY API ====================
SEPAY_API_TOKEN=your_sepay_token_here
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=your_account_name

# ==================== GHN API ====================
GHN_API_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_shop_id_here
