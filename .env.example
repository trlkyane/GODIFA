# GODIFA Environment Configuration
# Copy file này thành .env và điền thông tin phù hợp

# ==================== ENVIRONMENT ====================
# local hoặc production
APP_ENV=local

# ==================== DATABASE ====================
DB_HOST=localhost
DB_NAME=godifa_production
DB_USER=godifa_user
DB_PASS=Godifa@2025

# ==================== APPLICATION ====================
# Local: http://localhost/godifaproject.id.vn/
# VPS: https://godifaproject.id.vn/
BASE_URL=http://localhost/godifaproject.id.vn/

# ==================== WEBSOCKET ====================
# Local: http://localhost:3000
# VPS: https://godifaproject.id.vn/ws
SOCKET_SERVER_URL=http://localhost:3000

# ==================== SEPAY API ====================
SEPAY_API_TOKEN=your_sepay_token_here
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=your_account_name

# ==================== GHN API ====================
GHN_API_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_shop_id_here
