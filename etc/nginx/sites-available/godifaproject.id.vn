# --- BLOCK 1: HTTP (Port 80) - Chuyển hướng sang HTTPS ---
server {
    listen 80;
    listen [::]:80;
    server_name godifaproject.id.vn www.godifaproject.id.vn;
    
    # Certbot sẽ tự động thêm dòng redirect ở đây, hoặc bạn để dòng này:
    return 301 https://$host$request_uri;
}

# --- BLOCK 2: HTTPS (Port 443) - Nơi xử lý chính ---
server {
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    
    server_name godifaproject.id.vn www.godifaproject.id.vn;
    root /var/www/godifaproject.id.vn; # Đảm bảo đúng thư mục code của bạn
    index index.php index.html;

    # Cấu hình SSL (Certbot tự thêm, giữ nguyên các đường dẫn này)
    ssl_certificate /etc/letsencrypt/live/godifaproject.id.vn/fullchain.pem; 
    ssl_certificate_key /etc/letsencrypt/live/godifaproject.id.vn/privkey.pem; 
    include /etc/letsencrypt/options-ssl-nginx.conf; 
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; 

    # Logs
    access_log /var/log/nginx/godifa_access.log;
    error_log /var/log/nginx/godifa_error.log;

    # Xử lý Router MVC
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Xử lý PHP (SỬA THÀNH 8.1)
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock; # <-- Đã sửa thành 8.1
    }

    location /ws/ {
    rewrite ^/ws/(.*) /$1 break;
    proxy_pass http://localhost:3000;
    proxy_http_version 1.1;

    # WebSocket headers
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Standard proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Timeouts
    proxy_connect_timeout 7d;
    proxy_send_timeout 7d;
    proxy_read_timeout 7d;
    }
    # Chặn file nhạy cảm
    location ~ /\.(env|git|sql|log) {
        deny all;
    }
}
	
