# Copy file này thành .env và điền thông tin phù hợp

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=godifa1

# Server Configuration
PORT=3000

# Khi deploy lên VPS, thay đổi các giá trị trên theo thông tin VPS
# Ví dụ:
# DB_HOST=localhost
# DB_USER=godifa_user
# DB_PASS=your_secure_password
# DB_NAME=godifa_production
# PORT=3000
